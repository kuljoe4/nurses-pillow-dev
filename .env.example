# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE MAPS PLATFORM:
# Powers hospital Places Autocomplete (NS-02), split map view (NS-04), and commute calculations.
VITE_GOOGLE_MAPS_API_KEY="AIzaSyDaF-kyMHn1puwn5Q5w-_dkija7MPOsV8o"

# STRIPE CONNECT (SANDBOX):
# Powers 5% platform split payments and pre-authorization security deposit holds.
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_51PxxxxSandboxNursesPillow"

# TWILIO VERIFY (SANDBOX):
# Dispatches 6-digit SMS OTP tokens to travel nurses during clinical onboarding (AU-07).
VITE_TWILIO_VERIFY_SERVICE_SID="VA_test_nurses_pillow_otp_service"

# POSTMARK TRANSACTIONAL MAIL:
# Dispatches M1 verification emails, 24h booking requests, and itemized receipts.
VITE_POSTMARK_SERVER_TOKEN="pm_test_server_token_nursespillow"
