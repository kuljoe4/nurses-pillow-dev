# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/nursespillow"

# JWT
JWT_SECRET="your_secure_jwt_secret"

# GOOGLE MAPS PLATFORM:
# Powers hospital Places Autocomplete (NS-02), split map view (NS-04), and commute calculations.
VITE_GOOGLE_MAPS_API_KEY=""

# STRIPE CONNECT (SANDBOX):
# Powers 5% platform split payments and pre-authorization security deposit holds.
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_51PxxxxSandboxNursesPillow"
STRIPE_SECRET_KEY="sk_test_51PxxxxSandboxNursesPillow"
STRIPE_WEBHOOK_SECRET="whsec_xxxx"

# TWILIO VERIFY (SANDBOX):
# Dispatches 6-digit SMS OTP tokens to travel nurses during clinical onboarding (AU-07).
TWILIO_VERIFY_SERVICE_SID="VA_test_nurses_pillow_otp_service"

# POSTMARK TRANSACTIONAL MAIL:
# Dispatches M1 verification emails, 24h booking requests, and itemized receipts.
POSTMARK_SERVER_TOKEN="pm_test_server_token_nursespillow"
POSTMARK_WEBHOOK_SECRET="postmark_webhook_secret"
